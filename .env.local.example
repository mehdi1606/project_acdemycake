# ╔═════════════════════════════════════════════════════════════════╗
# ║       SARALÖWE ACADEMY — LOCAL ENVIRONMENT (Docker)             ║
# ║                                                                 ║
# ║  Run locally with:                                              ║
# ║    docker compose -f docker-compose.yml                         ║
# ║                   -f docker-compose.local.yml                   ║
# ║                   --env-file .env.local up -d --build           ║
# ║                                                                 ║
# ║  Your server config (.env.docker) is NOT touched.               ║
# ╚═════════════════════════════════════════════════════════════════╝

# ─── Local hostname ──────────────────────────────────────────────
SERVER_IP=

# ─── Database ─────────────────────────────────────────────────────
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ─── JWT (min 32 chars) ───────────────────────────────────────────
JWT_SECRET=

# ─── Mail (Gmail SMTP App Password) ──────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=

# ─── Mux (Video) ─────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ─── CMI Chaabi Payment  ───────────────────────────────────
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# ─── PayZone (legacy / unused) ───────────────────────────────────
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
PAYZONE_SECRET_KEY=

# ─── Bootstrap Admin ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# ─── Mux ENV Key (optional) ──────────────────────────────────────
REACT_APP_MUX_ENV_KEY=
