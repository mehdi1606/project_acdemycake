# ╔═════════════════════════════════════════════════════════════════╗
# ║       SARALÖWE ACADEMY — LOCAL ENVIRONMENT (Docker)             ║
# ║                                                                 ║
# ║  Run locally with:                                              ║
# ║    docker compose -f docker-compose.yml                         ║
# ║                   -f docker-compose.local.yml                   ║
# ║                   --env-file .env.local up -d --build           ║
# ║                                                                 ║
# ║  Your server config (.env.docker) is NOT touched.               ║
# ╚═════════════════════════════════════════════════════════════════╝

# ─── Local hostname ──────────────────────────────────────────────
SERVER_IP=

# ─── Database ─────────────────────────────────────────────────────
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ─── JWT (min 32 chars) ───────────────────────────────────────────
JWT_SECRET=

# ─── Mail (Gmail SMTP App Password) ──────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=

# ─── Mux (Video) ─────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ─── CMI Chaabi Payment  ───────────────────────────────────
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# ─── PayZone (legacy / unused) ───────────────────────────────────
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
PAYZONE_SECRET_KEY=

# ─── Bootstrap Admin ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# ─── Mux ENV Key (optional) ──────────────────────────────────────
REACT_APP_MUX_ENV_KEY=

# ─── Invoices (printed on every invoice PDF; empty = not printed) ─
# Legal name, address and Moroccan identifiers of the seller. VAT rate in
# percent (e.g. 20); 0 = invoices show only the total paid, no HT/TVA lines.
# Set these BEFORE the first start with invoices: existing payments are
# invoiced at that start with the VAT rate configured then.
INVOICE_SELLER_NAME=SARALÖWE
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_ICE=003660183000017
INVOICE_SELLER_IF=
INVOICE_SELLER_RC=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
INVOICE_VAT_RATE=20

# ─── PayPal (optional) ───────────────────────────────────────────
# developer.paypal.com → Apps & Credentials. sandbox = test money, live = real.
# Leave the keys empty to hide the PayPal button.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# MAD is not a PayPal currency: prices are charged in this currency at this rate.
PAYPAL_CURRENCY=EUR
PAYPAL_MAD_PER_UNIT=10.80
