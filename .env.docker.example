# ╔══════════════════════════════════════════════════════════════════╗
# ║          SARALÖWE ACADEMY — SERVER ENVIRONMENT                   ║
# ║  Copy this file to the server, fill in your values, then run:   ║
# ║      docker compose --env-file .env.docker up -d --build        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── SERVER IP ────────────────────────────────────────────────────
# Domain name (no http://, no trailing slash) — must match your SSL certificate
SERVER_IP=

# ─── Database ─────────────────────────────────────────────────────
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ─── JWT (min 32 chars) ───────────────────────────────────────────
JWT_SECRET=

# ─── Mail (Gmail SMTP App Password) ──────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

EMAIL_FROM=

# ─── Mux (Video) ─────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ─── CMI Chaabi Payment ───────────────────────────────────────────
CMI_CLIENT_ID=
# Must match the key configured in CMI back office:
# https://test-chaabipayment.cmi.co.ma/chaabipayment/report
# Administration → Changer les clés du magasin
#
# TEST environment default (CMI official sample default): TEST1234
# Change this to match whatever key is set in the CMI back office.
# For production, CMI will give you a different key.
CMI_STORE_KEY=
# Test gateway (change to production URL when CMI sends the production kit)
CMI_GATEWAY_URL=

# ─── PayZone (legacy) ────────────────────────────────────────────
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
PAYZONE_SECRET_KEY=

# ─── Bootstrap Admin ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# ─── Mux ENV Key (optional, for video analytics) ─────────────────
REACT_APP_MUX_ENV_KEY=
